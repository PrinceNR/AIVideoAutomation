

{
    "template_name": "Vocabulary",
    "slides_per_word": 4,

    "slides": [
        {
            "type": "VOCABULARY",

            "processors": [
                "text",
                "image",
                "audio",
                "progress"
            ],

            "audio": {
                "sequence": [
                    "pronunciation",
                    "pronunciation",
                    "meaning"
                ],
                "initial_delay": 0.5,
                "gap": 0.3
            }
        },

        {
            "type": "MEANING",

            "processors": [
                "text",
                "image",
                "audio",
                "progress"
            ],

            "audio": {
                "sequence": [
                    "past_sentence"
                ],
                "initial_delay": 0.5,
                "gap": 0.3
            }
        },

        {
            "type": "PRESENT",

            "processors": [
                "text",
                "image",
                "audio",
                "progress"
            ],

            "audio": {
                "sequence": [
                    "present_sentence"
                ],
                "initial_delay": 0.5,
                "gap": 0.3
            }
        },

        {
            "type": "FUTURE",

            "processors": [
                "text",
                "image",
                "audio",
                "progress"
            ],

            "audio": {
                "sequence": [
                    "future_sentence"
                ],
                "initial_delay": 0.5,
                "gap": 0.3
            }
        }
    ]
}
